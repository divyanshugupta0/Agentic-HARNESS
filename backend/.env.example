NODE_ENV=development
PORT=3001
AUTH_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/agentic-harness
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SAME_SITE=lax
TRUST_PROXY=false

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_CALLBACK_URL=http://localhost:3001/auth/microsoft/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Firebase Admin SDK (backend only). Use Application Default Credentials via
# GOOGLE_APPLICATION_CREDENTIALS, or provide the service account JSON securely.
FIREBASE_ADMIN_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
